<?xml version="1.0" encoding="utf-8"?>
<!-- Icono adaptativo (Android 8.0+): el sistema recorta el fondo y el
     frente con la forma del móvil (círculo, cuadrado redondeado...).
     El monocromo se usa en los iconos temáticos de Android 13+.
     Diseños originales en design/icono/. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
